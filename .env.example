# Public service IDs for the build (PLAN.md section 11, ADR 0023). Every one has a default
# in src/lib/public-config.ts, the live value; set one here (or as a GitHub repository variable)
# only to override it. They're public by design and end up in the page.

# Formspree form IDs (the part after /f/). Submissions are emailed to Johnny.
# PUBLIC_FORMSPREE_BOOKING=mqpeaklz
# PUBLIC_FORMSPREE_SIGNUP=mzedzbvd

# Google Analytics 4. It only runs on these hosts, so local builds and staging never count.
# PUBLIC_GA_ID=G-ZD74NE0HZS
# PUBLIC_GA_HOSTS=johnnyrhoades.com,www.johnnyrhoades.com

# Bandsintown (a secret: GitHub Actions secret only, never PUBLIC_):
# BANDSINTOWN_APP_ID=
