# Public service IDs for the build (PLAN.md section 11, ADR 0011).
# Copy to .env for local testing. In CI these are GitHub repository variables (not secrets):
# they're public by design and end up in the page.

# Web3Forms access key: booking requests are emailed to the address it was created with,
# which should be hello@johnnyrhoades.com, Johnny's work email (ADR 0021).
PUBLIC_WEB3FORMS_KEY=

# Buttondown username: mailing list signups.
PUBLIC_BUTTONDOWN_USER=

# Umami Cloud website ID: cookieless analytics. Leave empty to load no analytics at all.
PUBLIC_UMAMI_WEBSITE_ID=
# PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js
# PUBLIC_UMAMI_DOMAINS=johnnyrhoades.com

# Bandsintown (a secret: GitHub Actions secret only, never PUBLIC_):
# BANDSINTOWN_APP_ID=
