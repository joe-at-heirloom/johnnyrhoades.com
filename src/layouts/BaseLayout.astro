---
import '../styles/index.css';
import archivoUrl from '../assets/fonts/archivo-normal-latin.woff2?url';

interface Props {
  title: string;
  description?: string;
  /** Absolute canonical URL. Pages without one (thanks, 404) are noindex. */
  canonical?: string;
  /** Open Graph and Twitter card tags. */
  social?: { title: string; description: string; image: string; imageWidth: number; imageHeight: number };
  noindex?: boolean;
}

const { title, description, canonical, social, noindex = false } = Astro.props;
const siteName = 'Johnny Rhoades';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0d0b0a" />

    {
      social && (
        <>
          <meta property="og:type" content="website" />
          <meta property="og:site_name" content={siteName} />
          <meta property="og:title" content={social.title} />
          <meta property="og:description" content={social.description} />
          {canonical && <meta property="og:url" content={canonical} />}
          <meta property="og:image" content={social.image} />
          <meta property="og:image:width" content={String(social.imageWidth)} />
          <meta property="og:image:height" content={String(social.imageHeight)} />
          <meta name="twitter:card" content="summary_large_image" />
        </>
      )
    }

    <link rel="icon" type="image/png" sizes="64x64" href="/assets/img/favicon-64.png" />
    <link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png" />
    <link rel="preload" href={archivoUrl} as="font" type="font/woff2" crossorigin />
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
