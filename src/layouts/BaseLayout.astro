---
import '../styles/index.css';
import { getImage } from 'astro:assets';
import archivoUrl from '../assets/fonts/archivo-normal-latin.woff2?url';
import portrait from '../assets/photos/portrait.jpg';
import JsonLd from '../components/JsonLd.astro';
import { facts, media, profiles } from '../lib/load-content';
import { plain } from '../lib/facts';
import { sameAs } from '../lib/media';
import { siteGraph } from '../lib/schema';
import { SCHEMA_DESCRIPTION } from '../lib/copy';
import { NOINDEX, absolute } from '../lib/site';
import { PUBLIC_CONFIG } from '../lib/public-config';

interface Props {
  title: string;
  description?: string;
  /** Absolute canonical URL. */
  canonical?: string;
  /** Open Graph and Twitter card tags. */
  social?: { title: string; description: string; image: string; imageWidth: number; imageHeight: number; imageAlt?: string };
  /** e.g. "noindex" or "noindex, follow". */
  robots?: string;
}

const { title, description, canonical, social } = Astro.props;
const robots = NOINDEX ? 'noindex, nofollow' : Astro.props.robots;
const siteName = 'Johnny Rhoades';
const portraitImage = await getImage({ src: portrait, width: 1200, format: 'jpg', quality: 82 });
---

<!doctype html>
<html lang="en" data-ga-id={PUBLIC_CONFIG.gaId} data-ga-hosts={PUBLIC_CONFIG.gaHosts}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}
    {robots && <meta name="robots" content={robots} />}
    <meta name="theme-color" content="#0d0b0a" />

    {
      social && (
        <>
          <meta property="og:type" content="website" />
          <meta property="og:site_name" content={siteName} />
          <meta property="og:title" content={social.title} />
          <meta property="og:description" content={social.description} />
          {canonical && <meta property="og:url" content={canonical} />}
          <meta property="og:image" content={social.image} />
          <meta property="og:image:width" content={String(social.imageWidth)} />
          <meta property="og:image:height" content={String(social.imageHeight)} />
          {social.imageAlt && <meta property="og:image:alt" content={social.imageAlt} />}
          <meta name="twitter:card" content="summary_large_image" />
        </>
      )
    }

    <link rel="icon" type="image/png" sizes="64x64" href="/assets/img/favicon-64.png" />
    <link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="Johnny Rhoades: new shows" href="/shows/feed.xml" />
    <link rel="preload" href={archivoUrl} as="font" type="font/woff2" crossorigin />
    <JsonLd data={siteGraph({
        portraitUrl: absolute(portraitImage.src),
        sameAs: sameAs(profiles),
        album: media.album,
        description: plain(facts.third(SCHEMA_DESCRIPTION, 'schema')),
      })} />
    <slot name="head" />
  </head>
  <body>
    <slot />
    <script>
      // Google Analytics, on the real domain only, after the page is idle (ADR 0023).
      import '../scripts/analytics';
    </script>
  </body>
</html>
