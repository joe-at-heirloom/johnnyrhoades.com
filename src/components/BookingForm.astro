---
/*
  Booking request form (PLAN.md sections 7.1 and 11). Delivered by Web3Forms
  (src/lib/forms.ts). Without JavaScript it posts straight there and lands on
  /thanks/; with JavaScript it sends in place and builds a subject line Johnny
  can triage from his phone.
*/
import { WEB3FORMS_ENDPOINT } from '../lib/forms';
import { profiles } from '../lib/load-content';
import { liveLinks } from '../lib/media';
import { PUBLIC_CONFIG } from '../lib/public-config';
import { absolute } from '../lib/site';

const facebook = liveLinks(profiles).find((p) => p.name === 'Facebook');
const key = PUBLIC_CONFIG.web3formsKey;
const eventTypes = ['Bar / club', 'Festival', 'Private party', 'Wedding', 'Corporate', 'Something else'];
const acts = ['Not sure yet', 'Solo acoustic', 'Trio', 'Full band'];
if (!key && process.env.CI) console.warn('PUBLIC_WEB3FORMS_KEY is not set: the booking form will not deliver.');
---

<section class="section book" id="book" aria-labelledby="book-title">
  <div class="wrap">
    <header class="book-head">
      <div>
        <h2 class="display" id="book-title">Booking</h2>
        <p class="book-lede">Bars, festivals, private parties, you name it. Send me the date and where it is and I’ll get back to you.</p>
      </div>
      <div class="book-alts">
        {facebook && <p>Or message me on <a href={facebook.url} target="_blank" rel="noopener">Facebook</a>.</p>}
        <p>Booking agent or festival? See the <a href="/epk/">press kit</a>.</p>
      </div>
    </header>

    <form class="form" method="POST" action={key ? WEB3FORMS_ENDPOINT : '#book'} data-form="booking" data-web3forms-key={key}>
      {
        key && (
          <>
            <input type="hidden" name="access_key" value={key} />
            <input type="hidden" name="subject" value="Booking request from johnnyrhoades.com" />
            <input type="hidden" name="redirect" value={absolute('/thanks/')} />
          </>
        )
      }
      <p class="hp" aria-hidden="true"><label>Leave this unchecked <input type="checkbox" name="botcheck" tabindex="-1" /></label></p>

      <div class="form-grid">
        <div class="field">
          <label for="b-name">Name</label>
          <input id="b-name" name="name" type="text" autocomplete="name" required />
        </div>
        <div class="field">
          <label for="b-email">Email</label>
          <input id="b-email" name="email" type="email" autocomplete="email" required />
        </div>
        <div class="field">
          <label for="b-phone">Phone <span class="opt">optional</span></label>
          <input id="b-phone" name="phone" type="tel" autocomplete="tel" />
        </div>
        <div class="field">
          <label for="b-date">Date</label>
          <input id="b-date" name="date" type="date" />
        </div>
        <div class="field">
          <label for="b-venue">Where</label>
          <input id="b-venue" name="venue" type="text" placeholder="Venue and town" />
        </div>
        <div class="field">
          <label for="b-type">What kind of gig</label>
          <select id="b-type" name="event_type">
            {eventTypes.map((t) => <option>{t}</option>)}
          </select>
        </div>
        <div class="field">
          <label for="b-act">Solo, trio or band</label>
          <select id="b-act" name="act">
            {acts.map((a) => <option>{a}</option>)}
          </select>
        </div>
        <div class="field">
          <label for="b-budget">Budget <span class="opt">optional</span></label>
          <input id="b-budget" name="budget" type="text" inputmode="text" />
        </div>
        <div class="field field--wide">
          <label for="b-msg">Details</label>
          <textarea id="b-msg" name="message" rows="4" placeholder="How long a set, anything else I should know"></textarea>
        </div>
      </div>
      <div class="form-foot">
        <button class="btn btn-red" type="submit">Send booking request</button>
        <p class="form-status" role="status" aria-live="polite" data-form-status></p>
      </div>
    </form>
  </div>
</section>

<script>
  import '../scripts/forms';
</script>
