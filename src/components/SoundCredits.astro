---
/*
  Where the blues maker's sounds come from, and their licenses (ADR 0031).
  The instrument samples are rendered from MuseScore General, whose MIT
  license asks that its acknowledgements and copyright notices travel with
  any derivative work; the samples are served from this page, so the notice
  is here, word for word, read from the copy kept beside them.
*/
import raw from '../assets/jam/LICENSE-MuseScore_General.md?raw';

// The words exactly; only the spaces some lines end with are dropped.
const license = raw.replace(/[ \t]+$/gm, '');
---

<details class="jam-credits">
  <summary>Sound credits and licenses</summary>
  <p>
    Instruments and drums: <a class="text-link" href="https://musescore.org/en/handbook/soundfonts">MuseScore General</a> soundfont, version 0.2, by S. Christian Collins, from FluidR3 by Frank Wen and FluidR3Mono by Michael Cowgill, with the Splendid Grand piano (public domain). MIT license, below. Rendered note by note with FluidSynth.
  </p>
  <p>Room sounds (the bar and the old record): generated with ElevenLabs’ sound-effects model.</p>
  <pre class="jam-license">{license}</pre>
</details>
