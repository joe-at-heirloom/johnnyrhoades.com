---
/* Hidden until src/scripts/tonight.ts finds a show tonight in Detroit time (PLAN.md section 4.2). */
---

<aside class="tonight" data-tonight aria-label="Playing tonight" hidden>
  <div class="wrap tonight-inner">
    <p class="tonight-label">Tonight</p>
    <p class="tonight-what"><a data-tonight-link href="/shows/"><span data-tonight-venue></span></a>, <span data-tonight-town></span> <span class="tonight-sep">·</span> <span data-tonight-time></span></p>
    <p class="tonight-actions">
      <a data-tonight-directions href="/shows/" target="_blank" rel="noopener" data-event="directions_click" data-event-from="tonight">Directions</a>
      <a data-tonight-rsvp href="/shows/" target="_blank" rel="noopener" data-event="rsvp_click" data-event-from="tonight">RSVP on Bandsintown</a>
    </p>
  </div>
</aside>
