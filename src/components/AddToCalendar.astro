---
/* Google Calendar template link plus the per-show .ics file (PLAN.md section 7.2). */
import { googleCalendarUrl } from '../lib/links';
import { absolute, showPath } from '../lib/site';
import type { Show } from '../lib/shows-schema';

interface Props {
  show: Show;
}
const { show } = Astro.props;
---

<span class="add-to-calendar">
  <a class="btn btn-ghost" href={googleCalendarUrl(show, absolute(showPath(show.slug)))} target="_blank" rel="noopener">Add to Google Calendar</a>
  <a class="text-link" href={`/shows/${show.slug}.ics`} download>Apple or Outlook (.ics)</a>
</span>
