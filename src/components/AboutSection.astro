---
/* About, in Johnny's voice. Every sentence is a fact from the ledger (src/data/facts.yaml), first-person wording. */
import { Image } from 'astro:assets';
import FactText from './FactText.astro';
import { HOME_ABOUT } from '../lib/copy';
import { facts, image } from '../lib/load-content';

const paragraphs = HOME_ABOUT.map((ids) => ids.map((id) => facts.first(id)).join(' '));
---

<section class="section about" id="about" aria-labelledby="about-title">
  <div class="wrap about-grid">
    <figure class="about-photo">
      <Image
        src={image('photos/portrait.jpg')}
        widths={[700, 1100]}
        sizes="(min-width: 900px) 40vw, 90vw"
        quality={80}
        alt="Sepia portrait of Johnny Rhoades standing by a vine-covered fence, guitar at his side"
      />
    </figure>

    <div class="about-copy">
      <h2 class="display" id="about-title">Why I Sing the Blues</h2>
      {paragraphs.map((p) => <p><FactText text={p} /></p>)}
    </div>
  </div>
</section>
