---
import StrumNeck from './StrumNeck.astro';
import AlbumRecord from './AlbumRecord.astro';

const ALBUM_URL = 'https://music.apple.com/us/album/waiting-on-the-sun/942326904';
const AMAZON_URL = 'https://www.amazon.com/Waiting-Sun-Johnny-Rhoades/dp/B00PQ33NZK';

// Phase 4 moves these into src/data/media.yaml.
const tracks = [
  { title: 'Two Way Street', length: '3:33', appleId: '942326908', slug: 'two-way-street' },
  { title: 'It’s Always Better Together', length: '4:30', appleId: '942326909', slug: 'its-always-better-together' },
  { title: 'I Just Wanna Be Your Man', length: '5:08', appleId: '942326910', slug: 'i-just-wanna-be-your-man' },
  { title: 'Close to You', length: '4:15', appleId: '942326911', slug: 'close-to-you' },
  { title: 'Girl You Must Be Crazy', length: '2:52', appleId: '942326912', slug: 'girl-you-must-be-crazy' },
  { title: 'Heartbreakin’ Woman', length: '2:53', appleId: '942326913', slug: 'heartbreakin-woman' },
  { title: 'Let Myself Go', length: '3:27', appleId: '942326914', slug: 'let-myself-go' },
  { title: 'Summer Magic', length: '5:38', appleId: '942326915', slug: 'summer-magic' },
  { title: 'I Can’t Win for Losin’', length: '2:00', appleId: '942326916', slug: 'i-cant-win-for-losin' },
  { title: 'Walkin’ Blues', length: '5:08', appleId: '942326917', slug: 'walkin-blues' },
];
const trackUrl = (t: (typeof tracks)[number]) => `https://music.apple.com/us/album/${t.slug}/942326904?i=${t.appleId}`;
---

<section class="section music" id="music" aria-labelledby="music-title">
  <StrumNeck />

  <div class="wrap">
    <div class="album">
      <AlbumRecord />
      <div class="album-info">
        <h2 class="display" id="music-title">Waiting on the Sun</h2>
        <p class="album-meta">2014 <span aria-hidden="true">·</span> 10 songs</p>
        <ol class="tracklist">
          {
            tracks.map((t) => (
              <li>
                <a href={trackUrl(t)} target="_blank" rel="noopener">
                  <span class="t">{t.title}</span>
                  <span class="d">{t.length}</span>
                </a>
              </li>
            ))
          }
        </ol>
        <div class="actions">
          <a class="btn btn-red" href={ALBUM_URL} target="_blank" rel="noopener">Apple Music</a>
          <a class="btn btn-ghost" href={AMAZON_URL} target="_blank" rel="noopener">Amazon</a>
        </div>
      </div>
    </div>
  </div>
</section>
