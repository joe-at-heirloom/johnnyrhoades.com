---
/*
  The show card as inline SVG (ADR 0017): the poster on every show page,
  and the printed flyer. The same layout as the poster images, drawn as
  vector paths, so it prints sharp at any size. Its label is the poster's
  alt text; every fact on it is also in the page text.
*/
import { posterSvg } from '../lib/posters/render';
import type { Show } from '../lib/shows-schema';

interface Props {
  show: Show;
}
const svg = await posterSvg(Astro.props.show);
---

<Fragment set:html={svg} />
