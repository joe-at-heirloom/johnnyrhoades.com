---
import { Image, getImage } from 'astro:assets';
import { galleryLayout } from '../lib/gallery';
import { image, media } from '../lib/load-content';

// From media.yaml, placed by shape (src/lib/gallery.ts). `gridWidth` overrides
// the 700px tile size for narrower originals. Don't read properties off the
// image objects here: Astro then ships the full-size original alongside the
// resized copies.
const photos = galleryLayout(media.photos.filter((p) => p.use.includes('gallery'))).map(({ photo, slot }) => ({
  ...photo,
  slot,
  src: image(photo.file),
}));

// The lightbox loads a larger version on demand (never upscaled past the master).
const full = await Promise.all(photos.map((p) => getImage({ src: p.src, width: 1600, format: 'webp', quality: 80 })));
---

<section class="section photos" id="photos" aria-labelledby="photos-title">
  <div class="wrap">
    <header class="section-head">
      <h2 class="display" id="photos-title">Photos</h2>
    </header>

    <ul class="gallery" data-gallery>
      {
        photos.map((p, i) => (
          <li class={`g-${p.slot}`}>
            <button type="button" data-full={full[i]?.src}>
              {p.slot === 'feature' ? (
                <Image src={p.src} widths={[700, 1200]} sizes="(min-width: 760px) 50vw, 100vw" quality={76} alt={p.alt} />
              ) : (
                <Image src={p.src} width={p.gridWidth ?? 700} quality={76} alt={p.alt} />
              )}
            </button>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<dialog class="lightbox" data-lightbox aria-label="Photo viewer">
  <button class="lb-close" type="button" data-lb-close aria-label="Close">×</button>
  <button class="lb-nav lb-prev" type="button" data-lb-prev aria-label="Previous photo">‹</button>
  <figure class="lb-figure" data-lb-figure></figure>
  <button class="lb-nav lb-next" type="button" data-lb-next aria-label="Next photo">›</button>
</dialog>

<script>
  import '../scripts/lightbox';
</script>
