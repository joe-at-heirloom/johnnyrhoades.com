---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import seatedStudio from '../assets/photos/gallery/seated-studio.jpg';
import bluesByTheBay from '../assets/photos/gallery/blues-by-the-bay.jpg';
import outdoorFestival from '../assets/photos/gallery/outdoor-festival.jpg';
import duelingGuitars from '../assets/photos/gallery/dueling-guitars.jpg';
import bookshelf from '../assets/photos/gallery/bookshelf.jpg';
import barStage from '../assets/photos/gallery/bar-stage.jpg';
import mississippiBluesTrail from '../assets/photos/gallery/mississippi-blues-trail.jpg';
import festivalStage from '../assets/photos/gallery/festival-stage.jpg';
import fence from '../assets/photos/gallery/fence.jpg';
import backstage from '../assets/photos/gallery/backstage.jpg';

// Phase 4 moves these into src/data/media.yaml, with photographer credits.
// `width` is the grid size. Don't read properties off `src` here: Astro then
// ships the full-size original alongside the resized copies.
type Photo = { src: ImageMetadata; alt: string; width?: number };
const photos: Photo[] = [
  { src: seatedStudio, alt: 'Johnny seated with a hollow-body guitar in front of a wall of amplifiers, black and white' },
  { src: bluesByTheBay, alt: 'Johnny and another guitarist raising their fists onstage at a festival tent' },
  { src: outdoorFestival, alt: 'Johnny grinning mid-solo on an outdoor festival stage' },
  { src: duelingGuitars, alt: 'Two guitarists playing side by side onstage at night' },
  { src: bookshelf, alt: 'Johnny sitting with his guitar in a room lined with books, black and white' },
  { src: barStage, alt: 'Johnny and a bandmate playing a small bar stage under purple lights' },
  { src: mississippiBluesTrail, alt: 'Johnny and bandmates beside a Mississippi Blues Trail marker' },
  { src: festivalStage, alt: 'Johnny playing a Stratocaster beside a guitarist in a cream suit' },
  { src: fence, alt: 'Johnny standing by a wooden fence holding his guitar, black and white' },
  { src: backstage, alt: 'Johnny with his arm around a friend in an empty theater', width: 640 },
];

// The lightbox loads a larger version on demand (never upscaled past the master).
const full = await Promise.all(photos.map((p) => getImage({ src: p.src, width: 1600, format: 'webp', quality: 80 })));
---

<section class="section photos" id="photos" aria-labelledby="photos-title">
  <div class="wrap">
    <header class="section-head">
      <h2 class="display" id="photos-title">Photos</h2>
    </header>

    <ul class="gallery" data-gallery>
      {
        photos.map((p, i) => (
          <li>
            <button type="button" data-full={full[i]?.src}>
              <Image
                src={p.src}
                width={p.width ?? 700}
                quality={76}
                alt={p.alt}
              />
            </button>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<dialog class="lightbox" data-lightbox aria-label="Photo viewer">
  <button class="lb-close" type="button" data-lb-close aria-label="Close">×</button>
  <button class="lb-nav lb-prev" type="button" data-lb-prev aria-label="Previous photo">‹</button>
  <figure class="lb-figure">
    <img src="" alt="" data-lb-img />
  </figure>
  <button class="lb-nav lb-next" type="button" data-lb-next aria-label="Next photo">›</button>
</dialog>

<script>
  import '../scripts/lightbox';
</script>
