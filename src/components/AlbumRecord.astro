---
/* The album sleeve with the record half out of it, spinning at 33⅓, and a tonearm that drops onto it while a clip plays (src/scripts/track-player.ts). */
import { Image } from 'astro:assets';
import { image, media } from '../lib/load-content';
---

<div class="album-art" data-album-art>
  <div class="record" aria-hidden="true">
    <div class="record-disc">
      <svg class="record-label" viewBox="0 0 100 100">
        <defs>
          <path id="label-ring" d="M50,50 m-35,0 a35,35 0 1,1 70,0 a35,35 0 1,1 -70,0"></path>
        </defs>
        <circle cx="50" cy="50" r="49" fill="#c02e28"></circle>
        <circle cx="50" cy="50" r="44.5" fill="none" stroke="#efe6d3" stroke-opacity=".4" stroke-width=".5"></circle>
        <circle cx="50" cy="50" r="25" fill="none" stroke="#efe6d3" stroke-opacity=".4" stroke-width=".5"></circle>
        <text class="record-label-text" textLength="218" lengthAdjust="spacing">
          <textPath href="#label-ring">JOHNNY RHOADES ✦ WAITING ON THE SUN ✦</textPath>
        </text>
        <text class="record-label-side" x="50" y="44" text-anchor="middle">SIDE A</text>
        <text class="record-label-side" x="50" y="62" text-anchor="middle">33⅓</text>
        <circle cx="50" cy="50" r="3" fill="#0d0b0a"></circle>
      </svg>
    </div>
    <div class="record-sheen"></div>
  </div>
  <div class="tonearm" aria-hidden="true">
    <svg viewBox="0 0 40 300">
      <rect class="tonearm-weight" x="12" y="2" width="16" height="17" rx="3"></rect>
      <circle class="tonearm-base" cx="20" cy="30" r="13"></circle>
      <line class="tonearm-arm" x1="20" y1="30" x2="20" y2="262"></line>
      <circle class="tonearm-pivot" cx="20" cy="30" r="4.5"></circle>
      <rect class="tonearm-head" x="13" y="258" width="14" height="28" rx="2"></rect>
      <rect class="tonearm-cart" x="16" y="280" width="8" height="10" rx="1"></rect>
    </svg>
  </div>
  <Image src={image(media.album.cover)} width={900} height={900} quality={82} alt={media.album.coverAlt} />
</div>

<script>
  import '../scripts/album-record';
</script>
