---
/*
  The bandstand (ADR 0030): line drawings of the band, in the strum neck's
  style, that play along. src/scripts/bandstand.ts moves them on their notes:
  strings shake, keys go down, drum heads take the hit, the harmonica's holes
  and the sax's keys light. Each part has a drawing per tone; the one chosen
  shows, and a part that's off is dimmed.

  The band stands on a stage: a red valance across the top, and a floor
  drawn into each drawing that runs past its edges so a row's floors join.
  The instruments that would float (guitars, the electric bass, the keys,
  the harmonica, the sax) are on stands.

  In the game (ADR 0033) the band is who you play with, and each player
  does something when you tap them (src/scripts/game.ts): before a gig you
  hear them; during one the guitar or the keys take the calls, the drummer
  throws a fill, the bass drops the band out under your answer, and the
  fills' spot is you, where a tap switches your horn.

  With the advanced controls it's where the band is picked: each part has a switch by its name
  (clicking the drawing flips it too) and its tones in a segmented control
  under it (src/scripts/jam.ts). Those
  are the form's own radios, so the page still works, and a song is still a
  link, without JavaScript.

  Every string is a path whose ends are in data-x1/y1/x2/y2, so the script
  can shake it whatever angle it's drawn at.
*/
import { BASS_STRINGS, GUITAR_STRINGS, keyboard } from '../lib/bandstand';
import Segmented from './Segmented.astro';
import { DEFAULT_SONG, PART_LABELS, TONES, TONE_LABELS, TONE_SHORT, sampleNotes, type Part } from '../lib/jam';

const KEYS_LO = 48; // C3
const KEYS_HI = 76; // E5
const keys = keyboard(KEYS_LO, KEYS_HI, 184);

type Str = { x1: number; y1: number; x2: number; y2: number };
const str = (s: Str, i: number) => ({ 'data-string': i, 'data-x1': s.x1, 'data-y1': s.y1, 'data-x2': s.x2, 'data-y2': s.y2, d: `M${s.x1} ${s.y1} L${s.x2} ${s.y2}` });

// Upright bass, standing: four strings from the scroll down to the tailpiece.
const upright = BASS_STRINGS.map((_, i) => ({ x1: 95.5 + i * 3, y1: 14, x2: 94 + i * 4, y2: 124 }));
// Electric bass and the guitars lie on their sides, headstock right: low string at the bottom.
const electric = BASS_STRINGS.map((_, i) => ({ x1: 34, y1: 80 - i * 3, x2: 182, y2: 79.5 - i * 2.4 }));
const sixStrings = (bridge: number, y: number) => GUITAR_STRINGS.map((_, i) => ({ x1: bridge, y1: y + 6 - i * 2.4, x2: 174, y2: y + 5 - i * 2 }));
const hollow = sixStrings(40, 75);
const acoustic = sixStrings(36, 75);

const lead = (tone: string) => {
  const n = sampleNotes('lead', tone);
  return { 'data-lo': n[0], 'data-hi': n.at(-1) };
};
const parts: Part[] = ['drums', 'bass', 'guitar', 'keys', 'lead'];
// In the game the fills' spot is yours.
const GAME_NAMES: Partial<Record<Part, string>> = { lead: 'You' };
const song = DEFAULT_SONG;
---

<div class="stage">
<svg class="stage-valance" aria-hidden="true" width="100%" height="28">
  <defs>
    <pattern id="stage-valance" width="48" height="28" patternUnits="userSpaceOnUse">
      <path d="M0 0 H48 V12 A24 15 0 0 1 0 12 Z" />
    </pattern>
  </defs>
  <rect width="100%" height="28" fill="url(#stage-valance)" />
  <line x1="0" y1="1" x2="100%" y2="1" />
</svg>
<div class="bandstand" data-bandstand>
  {
    parts.map((part) => (
      <div class="band-piece" role="group" aria-labelledby={`band-${part}`} data-jam-light={part} data-band={part}>
        <div class="band-head">
          <span class="band-name" id={`band-${part}`}><span data-advanced-only>{PART_LABELS[part]}</span><span data-game-only>{GAME_NAMES[part] ?? PART_LABELS[part]}</span><span class="band-spot" aria-hidden="true">Solo</span></span>
          <button class="switch" type="button" role="switch" aria-checked={song.parts[part] ? 'true' : 'false'} aria-label={PART_LABELS[part]} data-band-toggle={part}>
            <span class="switch-knob"></span>
          </button>
        </div>
        {/* Clicking the drawing flips the switch (src/scripts/jam.ts); keyboards and screen readers use the switch itself. */}
        <div class="band-art" data-band-art={part}>
        <svg viewBox="0 0 200 162" class="band-svg" aria-hidden="true">
          {/* the stage floor: it runs past the drawing's edges so the floors of a row join up */}
          <path class="band-floor" d="M-40 150 H240 V160 H-40 Z" />
          <path class="band-faint" d="M-20 150 v10 M20 150 v10 M60 150 v10 M100 150 v10 M140 150 v10 M180 150 v10 M220 150 v10" />
          {part === 'drums' && (
            <g data-tone="sticks brushes" transform="translate(0 6)">
              {/* hi-hat */}
              <g data-drum="hat">
                <ellipse cx="30" cy="52" rx="22" ry="4" />
                <ellipse cx="30" cy="47" rx="22" ry="4" />
              </g>
              <line x1="30" y1="56" x2="30" y2="138" />
              <path d="M30 138 l-12 6 M30 138 l12 6" />
              {/* ride */}
              <g data-drum="ride">
                <ellipse cx="168" cy="36" rx="28" ry="6" />
                <circle cx="168" cy="35" r="3" />
              </g>
              <line x1="168" y1="42" x2="168" y2="138" />
              <path d="M168 138 l-12 6 M168 138 l12 6" />
              {/* rack tom */}
              <ellipse cx="118" cy="52" rx="15" ry="4.5" />
              <path d="M103 52 v12 a15 4.5 0 0 0 30 0 v-12" />
              {/* kick, with a tom-holder */}
              <g data-drum="kick">
                <circle cx="118" cy="104" r="36" />
                <circle cx="118" cy="104" r="29" class="band-faint" />
              </g>
              <line x1="118" y1="68" x2="118" y2="64" />
              {/* snare */}
              <g data-drum="snare">
                <ellipse cx="62" cy="86" rx="26" ry="7" />
                <path d="M36 86 v14 a26 7 0 0 0 52 0 v-14" />
              </g>
              <path d="M62 107 v26 l-10 10 M62 133 l10 10" />
            </g>
          )}

          {part === 'bass' && (
            <>
              <g data-tone="upright">
                <path d="M100 60 C82 59 73 65 75 78 C77 88 83 90 81 96 C67 103 62 117 66 130 C70 142 86 147 100 147 C114 147 130 142 134 130 C138 117 133 103 119 96 C117 90 123 88 125 78 C127 65 118 59 100 60 Z" />
                <path d="M84 104 c-4 6 4 10 0 16 M116 104 c4 6 -4 10 0 16" class="band-faint" />
                <path d="M96 62 V12 h8 V62" />
                <circle cx="100" cy="7" r="5" />
                <path d="M90 118 h20" />
                <path d="M100 147 V150" />
                {upright.map((s, i) => <path class="band-string" {...str(s, i)} />)}
              </g>
              <g data-tone="electric">
                <path d="M20 62 C12 50 24 38 42 42 C54 45 58 54 72 54 L72 98 C58 98 54 108 42 110 C24 114 12 102 20 90 C26 82 26 70 20 62 Z" />
                <path d="M72 71 H182 V83 H72" />
                <path d="M182 68 H198 V86 H182 Z" />
                <rect x="46" y="68" width="10" height="16" rx="2" class="band-faint" />
                {/* on a stand */}
                <path d="M42 112 L30 150 M42 112 L54 150 M35 132 h14" />
                {electric.map((s, i) => <path class="band-string" {...str(s, i)} />)}
              </g>
            </>
          )}

          {part === 'guitar' && (
            <>
              <g data-tone="crunch clean">
                <path d="M16 76 C16 52 34 44 48 50 C56 53 58 60 66 60 C72 60 74 56 78 56 L78 96 C74 96 72 92 66 92 C58 92 56 99 48 102 C34 108 16 100 16 76 Z" />
                <path d="M28 64 c4 4 -2 8 2 12 M60 86 c-4 -4 2 -8 -2 -12" class="band-faint" />
                <path d="M78 71 H174 V83 H78" />
                <path d="M174 69 L194 66 V88 L174 85 Z" />
                <rect x="38" y="70" width="6" height="14" class="band-faint" />
                <path d="M46 104 L34 150 M46 104 L58 150 M39 128 h14" />
                {hollow.map((s, i) => <path class="band-string" {...str(s, i)} />)}
              </g>
              <g data-tone="acoustic">
                <path d="M12 77 C12 50 30 44 46 50 C54 53 60 56 68 52 C82 46 96 56 96 77 C96 98 82 108 68 102 C60 98 54 101 46 104 C30 110 12 104 12 77 Z" />
                <circle cx="62" cy="77" r="9" class="band-faint" />
                <path d="M96 71 H174 V83 H96" />
                <path d="M174 69 L194 66 V88 L174 85 Z" />
                <path d="M32 70 v14" />
                <path d="M50 107 L38 150 M50 107 L62 150 M43 128 h14" />
                {acoustic.map((s, i) => <path class="band-string" {...str(s, i)} />)}
              </g>
            </>
          )}

          {part === 'keys' && (
            <g data-tone="piano organ" transform="translate(8 0)">
              <rect x="-6" y="44" width="196" height="88" rx="3" />
              {/* an X stand */}
              <path d="M24 132 L160 150 M160 132 L24 150" />
              <g data-tone="organ">
                {Array.from({ length: 9 }, (_, i) => (
                  <rect x={46 + i * 11} y="50" width="6" height={i < 3 ? 22 : 8} rx="1" class={i < 3 ? '' : 'band-faint'} />
                ))}
              </g>
              <g data-tone="piano">
                <path d="M-6 58 H190" class="band-faint" />
              </g>
              <g data-keys data-lo={KEYS_LO} data-hi={KEYS_HI}>
                {keys.filter((k) => !k.black).map((k) => <rect class="band-key" data-key={k.midi} x={k.x} y="78" width={k.w} height="48" />)}
                {keys.filter((k) => k.black).map((k) => <rect class="band-key band-key--black" data-key={k.midi} x={k.x} y="78" width={k.w} height="30" />)}
              </g>
            </g>
          )}

          {part === 'lead' && (
            <>
              <g data-tone="harp" data-holes {...lead('harp')}>
                <rect x="26" y="56" width="148" height="38" rx="5" />
                <path d="M26 64 H174 M26 86 H174" class="band-faint" />
                {/* held up on a stand */}
                <path d="M100 94 V138 M100 138 L86 150 M100 138 L114 150 M100 138 V150 M94 94 h12" />
                {Array.from({ length: 10 }, (_, i) => <rect class="band-hole" data-hole={i} x={34 + i * 13.6} y="69" width="8" height="12" rx="1.5" />)}
              </g>
              <g data-tone="sax" data-holes {...lead('sax')}>
                {/* mouthpiece and ligature */}
                <path d="M70 10 L58 11.5 Q55 12.5 58 13.5 L70 14.5" />
                <path d="M66 9.6 V14.9" class="band-faint" />
                {/* the neck, curving down into the body, with its octave key */}
                <path d="M70 10 C86 8 101 13 103 30 M70 14.5 C84 12.5 96 18 96 30" />
                <path d="M86 9.5 l4 -4 h6" class="band-faint" />
                {/* body, widening down to the bow */}
                <path d="M96 30 L94 106 C94 136 136 138 140 112 C142 96 144 78 153 64" />
                <path d="M103 30 L110 104 C110 118 124 120 126 108 C126 94 125 78 121 64" />
                {/* the bell, flared, with its rim */}
                <ellipse cx="137" cy="62" rx="16" ry="5" data-bell />
                <path d="M126 108 C130 116 138 116 140 112" class="band-faint" />
                {/* key guard on the bow */}
                <path d="M100 118 C104 126 114 128 120 124" class="band-faint" />
                {/* six pearl keys, in two stacks */}
                {[44, 53, 62, 78, 87, 96].map((y, i) => (
                  <circle class="band-hole" data-hole={i} cx={99.5 + (y - 30) * 0.06} cy={y} r="2.8" />
                ))}
                <path d="M97 70 h12" class="band-faint" />
                {/* its stand */}
                <path d="M114 132 L100 150 M114 132 L128 150 M114 132 V150" />
              </g>
            </>
          )}
        </svg>
        </div>
        {/* In the game, the whole drawing is a button, its chip saying what a tap does now. */}
        <button class="band-act" type="button" aria-label={`Hear the ${PART_LABELS[part].toLowerCase()}`} data-band-act={part} data-game-only>
          <span class="band-chip" data-band-chip>Hear</span>
        </button>
        <Segmented name={part} options={TONES[part].map((t) => ({ value: t, label: TONE_SHORT[t]!, full: TONE_LABELS[t]! }))} value={song.parts[part] ?? 'off'} />
        {/* "Off" is the switch's job; this keeps it in the form, so a song is still a link */}
        <input type="radio" name={part} value="off" checked={song.parts[part] === null} hidden />
      </div>
    ))
  }
</div>
{/* The game's key to the band's moves, shown before a gig (src/scripts/game.ts runs them). */}
<div class="stage-key" data-game-only>
  <p>Tap a player to hear them. In a gig, tap them to lead the band:</p>
  <ul>
    <li><strong>Call next</strong>: the guitar or the piano plays the next call for you to answer.</li>
    <li><strong>Drum fill</strong>: the drummer fills into the end of the line.</li>
    <li><strong>Play alone</strong>: the band stops under your answers, until you tap <strong>Band back</strong>.</li>
    <li><strong>You</strong>: tap to switch between harmonica and tenor sax.</li>
  </ul>
</div>
</div>
