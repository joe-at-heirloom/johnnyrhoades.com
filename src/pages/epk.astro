---
/*
  The press kit (PLAN.md section 7.4): the link Johnny pastes into booking
  emails. Third person, for people who book music. Every claim comes from
  the facts ledger; sections wait, rather than guess, when Johnny hasn't
  answered yet (PLAN.md section 17).
*/
import { Image } from 'astro:assets';
import { DateTime } from 'luxon';
import BaseLayout from '../layouts/BaseLayout.astro';
import CopyButton from '../components/CopyButton.astro';
import FactText from '../components/FactText.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import ProofLine from '../components/ProofLine.astro';
import { bio } from '../lib/bios';
import { EPK_FAQ, EPK_FAST_FACTS } from '../lib/copy';
import { facts, image, media, profiles, videoThumb } from '../lib/load-content';
import { allShows, BUILD_NOW } from '../lib/load-shows';
import { liveLinks } from '../lib/media';
import { pastShows, proofLine, upcomingShows } from '../lib/shows-data';
import { PRESS_ZIP, absolute } from '../lib/site';

const video = media.videos.find((v) => v.epk) ?? media.videos[0]!;
const yearAgo = BUILD_NOW.minus({ years: 1 });
const rooms = [
  ...new Map(
    [...upcomingShows(allShows, BUILD_NOW), ...pastShows(allShows, BUILD_NOW).filter((s) => DateTime.fromISO(s.start, { setZone: true }) >= yearAgo)]
      .filter((s) => s.status !== 'cancelled')
      .map((s) => [s.venue.key, `${s.venue.name}, ${s.venue.city}`] as const),
  ).values(),
].sort();
const highlights = facts.tagged('highlight');
const fastFacts = EPK_FAST_FACTS.map((id) => facts.get(id, 'epk'));
const photos = media.photos.filter((p) => p.use.includes('epk')).slice(0, 6);
const pressPhotos = media.photos.filter((p) => p.use.includes('press'));
const facebook = liveLinks(profiles).find((p) => p.name === 'Facebook');
const faq = [
  { q: 'Where is he based?', a: 'Detroit, Michigan.' },
  { q: 'What does he play?', a: EPK_FAQ.plays.map((id) => facts.third(id)).join(' ') },
  { q: 'Does he travel?', a: EPK_FAQ.travels.map((id) => facts.third(id)).join(' ') },
  { q: 'How do I book him?', a: 'Send the date, the room and the town through the booking form.' },
];
const description = 'Press kit for Johnny Rhoades, blues guitarist and singer from Detroit: video, bios, highlights, photos and how to book.';
---

<BaseLayout
  title="Johnny Rhoades Press Kit | Detroit Blues Guitarist for Venues, Festivals and Events"
  description={description}
  canonical={absolute('/epk/')}
  social={{ title: 'Johnny Rhoades press kit', description, image: absolute('/assets/img/og-image.jpg'), imageWidth: 1200, imageHeight: 630 }}
>
  <a class="skip-link" href="#main">Skip to content</a>
  <Header solid />

  <main id="main" class="page epk">
    <div class="wrap">
      <header class="epk-head">
        <p class="epk-kicker">Press kit</p>
        <h1 class="display">Johnny Rhoades</h1>
        <p class="lede epk-oneliner">Blues guitarist and singer from Detroit, Michigan.</p>
        <div class="actions">
          <a class="btn btn-red" href="/#book">Send a booking request</a>
          {facebook && <a class="text-link" href={facebook.url} target="_blank" rel="noopener">Message on Facebook</a>}
          <a class="text-link" href="#photos">Photos and logos</a>
        </div>
      </header>

      <section class="epk-video" aria-label={`Video: ${video.title}`}>
        <div class="video-frame" data-video-frame data-video-id={video.id} data-video-title={video.title}>
          <button class="video-facade" type="button" data-video-play aria-label={`Play video: ${video.title}`}>
            <Image src={videoThumb(video.id)} widths={[640, 960, 1280]} sizes="(max-width: 900px) 100vw, 1200px" quality={78} alt="" loading="eager" fetchpriority="high" />
            <span class="play-btn" aria-hidden="true"></span>
          </button>
        </div>
        <p class="epk-caption">{video.title} · {video.context}</p>
      </section>

      <div class="epk-grid">
        <section class="epk-section" aria-labelledby="bios-title">
          <h2 class="epk-title" id="bios-title">Bios</h2>
          <div class="epk-bio">
            <div class="epk-bio-head">
              <h3>Short</h3>
              <CopyButton target="bio-short" label="Copy short bio" />
            </div>
            <p id="bio-short"><FactText text={bio(facts, 'short')} /></p>
          </div>
          <div class="epk-bio">
            <div class="epk-bio-head">
              <h3>Medium</h3>
              <CopyButton target="bio-medium" label="Copy medium bio" />
            </div>
            <p id="bio-medium"><FactText text={bio(facts, 'medium')} /></p>
          </div>
        </section>

        <aside class="epk-section epk-side" aria-labelledby="facts-title">
          <h2 class="epk-title" id="facts-title">Fast facts</h2>
          <ProofLine text={proofLine(allShows, BUILD_NOW)} class="epk-proof" />
          <ul class="epk-facts">
            {
              fastFacts.map((f) => (
                <li>
                  <FactText text={f.third} />
                  {f.sources.find((s) => s.url) && (
                    <a class="epk-source" href={f.sources.find((s) => s.url)?.url} target="_blank" rel="noopener">
                      Source
                    </a>
                  )}
                </li>
              ))
            }
          </ul>
        </aside>
      </div>

      <section class="epk-section" aria-labelledby="highlights-title">
        <h2 class="epk-title" id="highlights-title">Highlights</h2>
        <ul class="epk-highlights">
          {
            highlights.map((f) => (
              <li>
                <FactText text={f.third} />
                {f.sources.find((s) => s.url) && (
                  <a class="epk-source" href={f.sources.find((s) => s.url)?.url} target="_blank" rel="noopener">
                    Source
                  </a>
                )}
              </li>
            ))
          }
        </ul>
      </section>

      {
        rooms.length > 0 && (
          <section class="epk-section" aria-labelledby="rooms-title">
            <h2 class="epk-title" id="rooms-title">Recent and upcoming rooms</h2>
            <p class="epk-rooms">{rooms.join(' · ')}</p>
            <p class="epk-more">
              <a class="text-link" href="/shows/">
                Full calendar <span aria-hidden="true">→</span>
              </a>
            </p>
          </section>
        )
      }

      <section class="epk-section epk-photos-section" id="photos" aria-labelledby="photos-title">
        <h2 class="epk-title" id="photos-title">Photos and logos</h2>
        <ul class="epk-photos">
          {
            photos.map((p) => (
              <li>
                <Image src={image(p.file)} width={600} quality={78} alt={p.alt} />
                {p.credit && !/from the watermark/i.test(p.credit) && <span class="epk-credit">Photo: {p.credit}</span>}
              </li>
            ))
          }
        </ul>
        <div class="actions epk-downloads">
          {
            pressPhotos.length > 0 ? (
              <a class="btn btn-ghost" href={`/press/${PRESS_ZIP}.zip`} download>
                Download press photos
              </a>
            ) : (
              <p class="epk-note">High-resolution photos are available on request. Use the booking form.</p>
            )
          }
          <a class="btn btn-ghost" href="/press/johnny-rhoades-logo-white.png" download>Download logo for dark backgrounds</a>
          <a class="btn btn-ghost" href="/press/johnny-rhoades-logo-black.png" download>Download logo for light backgrounds</a>
        </div>
      </section>

      <section class="epk-section" aria-labelledby="private-title">
        <h2 class="epk-title" id="private-title">Private events</h2>
        <p class="epk-text">For weddings, parties and corporate events, send the date, the place and the kind of event through the booking form.</p>
      </section>

      <section class="epk-section" aria-labelledby="faq-title">
        <h2 class="epk-title" id="faq-title">Questions</h2>
        <dl class="epk-faq">
          {
            faq.map(({ q, a }) => (
              <div>
                <dt>{q}</dt>
                <dd>
                  <FactText text={a} />
                </dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section class="epk-section epk-contact" aria-labelledby="contact-title">
        <h2 class="epk-title" id="contact-title">Booking</h2>
        <p class="epk-text">Bars, clubs, festivals and private events.</p>
        <div class="actions">
          <a class="btn btn-red" href="/#book">Send a booking request</a>
          {facebook && <a class="text-link" href={facebook.url} target="_blank" rel="noopener">Message on Facebook</a>}
        </div>
        <p class="epk-print-url">johnnyrhoades.com/epk</p>
      </section>
    </div>
  </main>

  <Footer />
</BaseLayout>

<script>
  import '../scripts/video-stage';
</script>
