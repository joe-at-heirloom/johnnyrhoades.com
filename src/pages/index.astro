---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import TonightBar from '../components/TonightBar.astro';
import ProofLine from '../components/ProofLine.astro';
import ShowsSection from '../components/ShowsSection.astro';
import MusicSection from '../components/MusicSection.astro';
import VideoStage from '../components/VideoStage.astro';
import AboutSection from '../components/AboutSection.astro';
import PhotoGallery from '../components/PhotoGallery.astro';
import BookingForm from '../components/BookingForm.astro';
import MailingList from '../components/MailingList.astro';
import Footer from '../components/Footer.astro';
import NextShowsData from '../components/NextShowsData.astro';
import JsonLd from '../components/JsonLd.astro';
import { media } from '../lib/load-content';
import { videoObject } from '../lib/schema';
import { allShows, BUILD_NOW } from '../lib/load-shows';
import { proofLine } from '../lib/shows-data';
import { absolute } from '../lib/site';

const proof = proofLine(allShows, BUILD_NOW);
---

<BaseLayout
  title="Johnny Rhoades · Blues Guitarist & Singer, Detroit"
  description="Johnny Rhoades, blues guitarist and singer from Detroit. Shows, music, videos and booking."
  canonical={absolute('/')}
  social={{
    title: 'Johnny Rhoades',
    description: 'Blues guitarist and singer from Detroit.',
    image: absolute('/assets/img/og-image.jpg'),
    imageWidth: 1200,
    imageHeight: 630,
  }}
>
  {media.videos.map((v) => <JsonLd slot="head" data={videoObject(v)} />)}
  <a class="skip-link" href="#main">Skip to content</a>
  <Header />
  <main id="main">
    <Hero />
    <TonightBar />
    {proof && <div class="wrap proof-wrap"><ProofLine text={proof} /></div>}
    <ShowsSection />
    <MusicSection />
    <VideoStage />
    <AboutSection />
    <PhotoGallery />
    <BookingForm />
    <MailingList />
  </main>
  <Footer />
  <NextShowsData shows={allShows} now={BUILD_NOW} />
</BaseLayout>
